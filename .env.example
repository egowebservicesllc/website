# Lead automation: copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values. Each block is optional: a service with no keys is simply skipped.

# Site
SITE_URL=https://www.egowebservices.com
ALLOWED_ORIGINS=https://www.egowebservices.com,https://egowebservices.com

# ClickUp: Settings → Apps → API Token; List ID from the list's URL
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_STATUS_REPLIED=      # optional, must match a status in that list, e.g. contacted
CLICKUP_STATUS_PAID=         # optional, e.g. won

# Slack app (see AUTOMATION-SETUP.md)
SLACK_BOT_TOKEN=             # xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=            # e.g. C0123456789 for #leads

# Email via Resend (domain egowebservices.com must be verified)
RESEND_API_KEY=
EMAIL_FROM=EGO Web Services <hello@egowebservices.com>
EMAIL_REPLY_TO=info@egowebservices.com
INTERNAL_NOTIFY_EMAIL=       # optional: BCC of every confirmation
SIGNATURE_NAME=The EGO Web Services team
CALENDLY_URL=https://calendly.com/egowebservices/30min
RESPONSE_TIME=1 business day

# Stripe (account payments@egowebservices.com). Use a RESTRICTED key.
STRIPE_SECRET_KEY=           # rk_live_... (or rk_test_... while testing)
STRIPE_WEBHOOK_SECRET=       # whsec_...
STRIPE_CURRENCY=usd

# AI reply drafts (optional; without it a template draft is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Client portal (portal.egowebservices.com)
PORTAL_SECRET=               # long random string, e.g. run: openssl rand -hex 32
PORTAL_URL=https://portal.egowebservices.com
CLICKUP_WEBHOOK_SECRET=      # shown once by /api/clickup?action=setup&key=<PORTAL_SECRET>
